[Unit]
Description=TwinVolt Universal Battery Digital Twin Edge Server
Documentation=https://github.com/Prashant110405/TwinVolt-Battery-Digital-Twin
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=twinvolt
Group=twinvolt
# Add dialout group for serial UART (/dev/ttyUSB*, /dev/ttyACM*) hardware permissions
SupplementaryGroups=dialout

# Deployment working directory and virtual environment
WorkingDirectory=/opt/twinvolt
EnvironmentFile=-/etc/default/twinvolt
ExecStart=/opt/twinvolt/venv/bin/python -m src.server --host 0.0.0.0 --port 8000

# Process lifecycle and recovery
Restart=always
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=15

# Security sandbox hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
