# ==============================================================================
# TwinVolt — Universal Battery Digital Twin Platform
# Environment Configuration Template (.env.example)
#
# IMPORTANT NOTICE:
# 1. Do NOT commit the actual `.env` file containing real credentials or keys.
# 2. Copy this file to `.env` (`cp .env.example .env`) and adjust for local dev.
# 3. All default values provided below are safe placeholders for development only.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. General Application Settings
# ------------------------------------------------------------------------------
TWINVOLT_ENV=development                # Options: development, staging, production, testing
TWINVOLT_DEBUG=true                    # Boolean: true | false
TWINVOLT_LOG_LEVEL=INFO                # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
TWINVOLT_SECRET_KEY=change_this_to_a_secure_random_key_in_production

# ------------------------------------------------------------------------------
# 2. API Server & Networking
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# CORS_ORIGINS: comma-separated list of allowed frontend origins.
# In local dev the localhost entries are always permitted automatically.
# In production (Vercel + separate backend), add your Vercel deployment URL:
#   CORS_ORIGINS=https://twinvolt.vercel.app,https://twinvolt-preview.vercel.app
# All *.vercel.app preview URLs are permitted automatically via regex.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# 3. Vercel Production Deployment — Frontend ↔ Backend URL Configuration
# ------------------------------------------------------------------------------
# These variables configure the frontend (Vercel static SPA) to point at the
# separately-deployed FastAPI backend (Railway / Render / VPS / Docker).
#
# HOW IT WORKS:
#  1. Deploy the FastAPI backend on Railway / Render / any persistent host.
#  2. Set these variables in Vercel Dashboard → Project → Environment Variables.
#  3. Run `python scripts/build-config.py` in your CI/CD step to inject the
#     URLs into src/ui/js/config.js before the Vercel build.
#  4. Vercel deploys the updated config.js as a static asset. The browser
#     reads window.TWINVOLT_API_BASE_URL and window.TWINVOLT_WS_BASE_URL
#     from it at runtime.
#
# TWINVOLT_API_BASE_URL: The full HTTPS URL of your backend (no trailing slash).
#   Example: https://twinvolt-api.railway.app
# TWINVOLT_WS_BASE_URL: The full WSS URL of your backend (no trailing slash).
#   Example: wss://twinvolt-api.railway.app
#   (If not set, scripts/build-config.py derives it from TWINVOLT_API_BASE_URL.)
#
TWINVOLT_API_BASE_URL=
TWINVOLT_WS_BASE_URL=

# ------------------------------------------------------------------------------
# 4. Relational Database (PostgreSQL / TimescaleDB) — reserved for future use
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=twinvolt_db
DB_USER=twinvolt_user
DB_PASSWORD=placeholder_db_password
DB_SSL_MODE=prefer                     # Options: disable, allow, prefer, require

# ------------------------------------------------------------------------------
# 5. In-Memory Cache & Message Broker (Redis) — reserved for future use
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ------------------------------------------------------------------------------
# 6. Telemetry & Ingestion (MQTT Broker) — reserved for future use
# ------------------------------------------------------------------------------
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=twinvolt_core_service
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_BASE_TOPIC=twinvolt/telemetry
MQTT_KEEP_ALIVE_SECONDS=60

# ------------------------------------------------------------------------------
# 7. Physical Hardware & Serial Adapters (Optional / Local Dev)
# ------------------------------------------------------------------------------
SERIAL_ADAPTER_ENABLED=false
SERIAL_PORT=/dev/ttyUSB0               # e.g., COM3 on Windows or /dev/ttyUSB0 on Linux
SERIAL_BAUDRATE=115200
CAN_INTERFACE=vcan0                    # e.g., vcan0, can0, slcan

# ------------------------------------------------------------------------------
# 8. Battery Digital Twin & Simulation Engine Configuration
# ------------------------------------------------------------------------------
SIMULATION_STEP_MS=100                 # Internal simulation step size in milliseconds
DEFAULT_BATTERY_CHEMISTRY=NMC          # e.g., NMC, LFP, LCO, NCA, LTO
DEFAULT_CELL_COUNT_SERIES=3            # Default configuration for test harnesses
DEFAULT_CELL_COUNT_PARALLEL=1
ENABLE_REALTIME_ESTIMATION=true        # Run state estimation pipeline
ENABLE_SYNTHETIC_TELEMETRY=false       # Replay/generate synthetic battery profiles

# ------------------------------------------------------------------------------
# 9. TwinVolt-specific Server Settings (read by src/config/settings.py)
# ------------------------------------------------------------------------------
TWINVOLT_HOST=0.0.0.0
TWINVOLT_PORT=8000
TWINVOLT_GATEWAY_AUTOSTART=false
TWINVOLT_GATEWAY_QUEUE_SIZE=1000
TWINVOLT_GATEWAY_OVERFLOW_POLICY=DROP_OLDEST
TWINVOLT_STORAGE_DIR=data/storage
TWINVOLT_SEED_DEFAULTS=true
