{
  "version": 2,
  "name": "twinvolt-ui",
  "comment": "TwinVolt — Vercel serves the static frontend SPA only. The FastAPI backend (WebSocket, REST API, hardware gateway, mock service) must be deployed separately on a persistent server (e.g. Railway, Render, Docker, or a local edge gateway). Set VITE_API_BASE_URL and VITE_WS_BASE_URL in Vercel Environment Variables to point the frontend at your backend.",
  "buildCommand": "echo 'No build step needed – TwinVolt frontend is a vanilla ES module SPA.'",
  "outputDirectory": "src/ui",
  "installCommand": "echo 'No package install needed.'",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.js",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)\\.css",
      "headers": [
        { "key": "Content-Type", "value": "text/css; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)\\.svg",
      "headers": [
        { "key": "Content-Type", "value": "image/svg+xml" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}

